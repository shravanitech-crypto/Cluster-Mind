PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/shopsmart_db
# Required. The server refuses to start if this is missing.
JWT_SECRET=

# Razorpay
# RAZORPAY_KEY_ID is publishable and reaches the browser.
# RAZORPAY_KEY_SECRET is server-only: never commit it, never return it from an API.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret configured in the Razorpay dashboard webhook settings. Required for
# webhook verification (the endpoint returns 503 until it is set).
RAZORPAY_WEBHOOK_SECRET=